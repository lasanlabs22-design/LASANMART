{
  "expo": {
    "name": "Lasan Mart",
    "slug": "LasanMart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lasan-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lasanmart.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lasan Mart uses your location to set your business address for local campaigns.",
        "NSPhotoLibraryUsageDescription": "Lasan Mart needs access to your photos so you can set a profile picture, company logo and post reels."
      }
    },
    "android": {
      "package": "com.lasanmart.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0D1A",
        "foregroundImage": "./assets/lasan-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/lasan-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lasan Mart needs access to your photos and videos so you can set a profile picture, company logo and post reels."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lasan Mart uses your location to set your business address for local campaigns."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bab57ed5-a0a2-461f-9c52-c7cb72685be4"
      }
    }
  }
}
