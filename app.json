{
  "expo": {
    "name": "Lasan Mart",
    "slug": "LasanMart",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/lasan-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lasanmart.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lasan Mart uses your location to set your business address for local campaigns.",
        "NSPhotoLibraryUsageDescription": "Lasan Mart needs access to your photos so you can set a profile picture, company logo and post reels."
      }
    },
    "android": {
      "package": "com.lasanmart.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBWGPWHVNyIF3zbj_g4JGCIYKmyhQeiDkQ"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#0B0D1A",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "ios": { "useFrameworks": "static" }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/lasan-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lasan Mart needs access to your photos and videos so you can set a profile picture, company logo and post reels.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lasan Mart uses your location to set your business address for local campaigns."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bab57ed5-a0a2-461f-9c52-c7cb72685be4"
      }
    }
  }
}
